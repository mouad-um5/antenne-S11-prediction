# development, test ou production
APP_ENV=development

# Origines frontend autorisées à appeler directement l'API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hôtes HTTP acceptés.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Désactiver la documentation interactive en production.
ENABLE_API_DOCS=true

# Devient true par défaut lorsque APP_ENV=production.
REQUIRE_VERIFIED_MODEL_SCOPE=false

# Chemins optionnels, relatifs au dossier backend ou absolus.
# MODEL_PATH=models/s11_predictor.pkl
# MODEL_INFO_PATH=models/model_info.json

# Extraction de paramètres depuis un paragraphe (clé privée, backend uniquement).
GEMINI_API_KEY=
# Choix initial : gemini-3.6-flash, gemini-3.8-flash ou gemini-3.5-flash-lite.
# L'utilisateur peut choisir un autre modèle dans l'interface.
GEMINI_MODEL=gemini-3.6-flash

# Groq : clé distincte de Gemini, à créer sur https://console.groq.com/keys
# Le modèle openai/gpt-oss-20b se sélectionne dans l'interface.
GROQ_API_KEY=

# Cloudflare Workers AI and Mistral (server only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MISTRAL_API_KEY=
