# Port public du site.
APP_PORT=8080

# Origine publique exacte si le frontend appelle l'API depuis un autre domaine.
CORS_ORIGINS=http://localhost:8080

# Laisser false en production, sauf besoin explicite de /docs.
ENABLE_API_DOCS=false

# Garde-fou scientifique. Conserver true pour bloquer les prédictions tant que
# le modèle n'a pas été réentraîné avec une famille/variante vérifiée.
REQUIRE_VERIFIED_MODEL_SCOPE=true

# Extraction de paramètres depuis un paragraphe (clé privée, backend uniquement).
GEMINI_API_KEY=
# Choix initial : gemini-3.6-flash, gemini-3.8-flash ou gemini-3.5-flash-lite.
# L'utilisateur peut choisir un autre modèle dans l'interface.
GEMINI_MODEL=gemini-3.6-flash

# Groq : clé distincte de Gemini, à créer sur https://console.groq.com/keys
# Le modèle openai/gpt-oss-20b se sélectionne dans l'interface.
GROQ_API_KEY=

# Cloudflare Workers AI and Mistral (server only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MISTRAL_API_KEY=
